# Reference only. In real runtime these variables should be injected by Doppler.

# Required
ENVIRONMENT=dev
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO
LOG_FORMAT=text
JWT_ALGORITHM=HS256
JWT_SHARED_SECRET=change-me-local-dev-secret
JWT_ISSUER=mcp-log-server-dev
JWT_AUDIENCE=mcp-log-server
JWT_EXPIRATION_SECONDS=86400
DEFAULT_LOG_WINDOW=24h
WORKFLOW_ARCHIVE_RETENTION=14d
LOG_SNAPSHOT_RETENTION=7d
MANIFEST_PATH=src/manifests/landingpage.json
MCP_PATH=/mcp
MCP_STATELESS_HTTP=true
MCP_JSON_RESPONSE=true
