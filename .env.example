# Reference only. In real runtime these variables should be injected by Doppler.

# Required
ENVIRONMENT=local
SITE_DOMAIN=example.com
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PORT_HOST=8001
LOG_LEVEL=INFO
JWT_SHARED_SECRET=change-me-local-dev-secret
JWT_JWKS_URI=
JWT_ISSUER=mcp-log-server-dev
JWT_AUDIENCE=mcp-log-server
LOGS_DIR=/app/logs
SOCKET_APP_SOCKET_PATH=/run/socket-app/gateway.sock
DOCKER_SOCKET_APP_TIMEOUT_SECONDS=300
MAX_LOG_TRANSFER_BYTES=268435456
# Manifest JSON files are passed to upload/update commands with --path.
# Runtime MCP tools read persisted manifests from the database.
# File-backed manifest source targets must be absolute paths.

# Database runtime
# Local host processes use 127.0.0.1. Docker Compose injects DATABASE_HOST=db
# for containers on the Compose network.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_PORT_HOST=5437
DATABASE_NAME=mcp_log_server
DATABASE_USER=mcp_log_server
DATABASE_PASSWORD=mcp-log-server-local-password
BACKUP_INSPECTION_ROOTS=/host/var/backups
