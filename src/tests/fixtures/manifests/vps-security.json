{
  "project_key": "vps-security",
  "project_summary": "VPS security logs for CrowdSec and edge-proxy probe analysis.",
  "static_asset_paths": [],
  "static_asset_extensions": [],
  "sources": [
    {
      "source_key": "crowdsec_runtime",
      "source_type": "docker",
      "target": "crowdsec",
      "compose_project": "crowdsec",
      "compose_service": "crowdsec",
      "stream": "stdout",
      "description": "CrowdSec container runtime logs for Traefik log acquisition, AppSec, LAPI, bouncer authentication, decisions, and hub collection activity.",
      "required": true,
      "parser_type": "plain_text",
      "normalization_profile": "security_events",
      "retention_class": "medium",
      "default_noise_profile": "security_noise",
      "inspect_path_prefixes": [
        "/etc/crowdsec/",
        "/var/lib/crowdsec/",
        "/var/log/traefik/"
      ]
    },
    {
      "source_key": "nginx_access",
      "source_type": "file",
      "target": "/app/src/tests/fixtures/logs/vps-security/nginx_access.log",
      "description": "Production nginx access log for legacy ingress diagnostics.",
      "required": false,
      "parser_type": "nginx_json",
      "normalization_profile": "proxy_access",
      "retention_class": "short",
      "default_noise_profile": "web_noise",
      "inspect_path_prefixes": []
    },
    {
      "source_key": "nginx_runtime",
      "source_type": "file",
      "target": "/app/src/tests/fixtures/logs/vps-security/nginx_runtime.log",
      "description": "Production nginx runtime/error log for ingress diagnostics.",
      "required": false,
      "parser_type": "plain_text",
      "normalization_profile": "proxy_access",
      "retention_class": "medium",
      "default_noise_profile": "web_noise",
      "inspect_path_prefixes": []
    },
    {
      "source_key": "traefik_access",
      "source_type": "file",
      "target": "/app/src/tests/fixtures/logs/vps-security/traefik_access.log",
      "description": "Traefik access log consumed by CrowdSec probe analysis.",
      "required": false,
      "parser_type": "traefik_json",
      "normalization_profile": "proxy_access",
      "retention_class": "short",
      "default_noise_profile": "proxy_noise",
      "inspect_path_prefixes": []
    }
  ]
}
